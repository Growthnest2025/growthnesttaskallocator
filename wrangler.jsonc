{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "growthnest-task-portal",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "growthnest-db",
      "database_id": "711920ee-a36f-434d-885d-61ba30748d22"
    }
  ],
  "vars": {
    "PORTAL_NAME": "GrowthNest Tech Solutions Task Portal",
    "JWT_SECRET": "growthnest-institute-super-secret-key-2026"
  }
}
